{
  "name": "opencode-posh",
  "version": "1.2.2",
  "description": "OpenCode plugin: gives OpenCode version-matched Ruby and gem API documentation and prompts it to check it before relying on memory. Requires POSH to be installed and activated.",
  "keywords": [
    "ruby",
    "rails",
    "documentation",
    "mcp",
    "opencode",
    "opencode-plugin"
  ],
  "license": "MIT",
  "homepage": "https://poshtui.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skatkov/posh-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/skatkov/posh-mcp/issues"
  },
  "type": "module",
  "main": "./opencode/posh.mjs",
  "exports": {
    ".": "./opencode/posh.mjs"
  },
  "files": [
    "opencode/",
    "shared/",
    "skills/",
    "LICENSE-POSH"
  ],
  "peerDependencies": {
    "@opencode/plugin": "^2.3.0"
  },
  "devDependencies": {
    "@opencode/plugin": "2.3.0",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@vitest/coverage-v8": "5.1.0",
    "vitest": "5.1.0",
    "yaml": "2.9.1"
  },
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "preversion": "git symbolic-ref --short HEAD | grep -qx main || { echo 'Release from main only.' >&2; exit 1; }; npm test",
    "version": "node scripts/sync-version.mjs",
    "postversion": "git push --follow-tags"
  }
}
