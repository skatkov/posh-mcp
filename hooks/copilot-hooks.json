{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "sh \"${COPILOT_PLUGIN_ROOT}/hooks/posh-copilot-hook.sh\" SessionStart",
        "timeoutSec": 5
      }
    ],
    "subagentStart": [
      {
        "type": "command",
        "bash": "sh \"${COPILOT_PLUGIN_ROOT}/hooks/posh-copilot-hook.sh\" SubagentStart",
        "timeoutSec": 5
      }
    ],
    "userPromptTransformed": [
      {
        "type": "command",
        "bash": "sh \"${COPILOT_PLUGIN_ROOT}/hooks/posh-copilot-hook.sh\" UserPromptSubmit",
        "timeoutSec": 5
      }
    ],
    "preToolUse": [
      {
        "type": "command",
        "bash": "sh \"${COPILOT_PLUGIN_ROOT}/hooks/posh-copilot-hook.sh\" PreToolUse",
        "timeoutSec": 5
      }
    ]
  }
}
