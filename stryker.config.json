{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "mutate": [
    "shared/lookup-policy.mjs",
    "shared/agent-lifecycle.mjs",
    "opencode/posh.mjs",
    "hooks/posh-pre-tool-use.mjs",
    "hooks/posh-copilot-hook.mjs",
    "evals/check-evidence.mjs"
  ],
  "ignorePatterns": ["/reports/**"],
  "testRunner": "vitest",
  "vitest": {
    "pool": "forks",
    "related": false
  },
  "incremental": true,
  "incrementalFile": "reports/mutation/stryker-incremental.json",
  "concurrency": 4,
  "timeoutMS": 30000,
  "thresholds": {
    "high": 100,
    "low": 100,
    "break": 100
  },
  "reporters": ["clear-text", "progress", "html", "json"],
  "htmlReporter": {
    "fileName": "reports/mutation/index.html"
  }
}
